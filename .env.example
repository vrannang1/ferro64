# Copy to .env; the app reads it at startup. Variables exported in your shell win.

# Inference engine: llamacpp (default, managed llama-server) or ollama.
LLM_BACKEND=llamacpp
LLAMACPP_BIN=llama-server
# Seconds the selected model stays loaded after its last request (0 = unload after every reply).
LLAMACPP_KEEP_ALIVE=600
# Context window. Unset: 65536 with 40 GB of GPU memory or more, 8192 on machines under 16 GB, otherwise 32768.
# LLAMACPP_CTX_SIZE=32768
LLAMACPP_GPU_LAYERS=99
# Unset = pick a free loopback port automatically.
# LLAMACPP_PORT=11435
# Extra folders scanned for .gguf files, separated by ':'.
# LLAMACPP_MODEL_DIRS=/path/to/more/models
# An explicit registry overrides discovery (see data/llamacpp-models.example.json).
# LLAMACPP_MODELS_FILE=/absolute/path/to/llamacpp-models.json
# Download the default chat model (Qwen3.5 9B) on first start. Off: Settings shows what fits.
AUTO_DOWNLOAD_MODEL=0

# Ollama backend
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=32768

# Image generation: unset picks stable-diffusion.cpp when sd-cli is present
# (scripts/setup.sh installs it), then mflux, then Ollama.
# IMAGE_BACKEND=sdcpp
# SDCPP_BIN=/absolute/path/to/sd-cli
# Fallbacks:
# IMAGE_BACKEND=mlx
# MFLUX_BIN=/absolute/path/to/mflux-generate-flux2
# IMAGE_BACKEND=ollama   (recent Ollama versions no longer generate images)
# IMAGE_MODEL=x/flux2-klein:4b

# Web answers: Keenable's keyless search by default (1,000 an hour), falling
# back to DuckDuckGo. A key or server here takes over, first match wins.
# KEENABLE_API_KEY=   (free account: 100K requests a month)
# BRAVE_API_KEY=
# SEARXNG_URL=http://localhost:8888   (enable the json format in settings.yml)

HOST=127.0.0.1
PORT=3042

# Off by default. on = API models tab, vendor keys and the /v1 proxy. Costs money per token, and sends your code to the vendor.
# FERRO64_API_MODELS=on
